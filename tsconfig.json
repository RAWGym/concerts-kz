{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "next/link": [
        "./src/shims/link.tsx"
      ],
      "next/image": [
        "./src/shims/image.tsx"
      ],
      "next/navigation": [
        "./src/shims/navigation.ts"
      ],
      "next": [
        "./src/shims/next.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}